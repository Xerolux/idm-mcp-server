# IP-Adresse oder Hostname der Wärmepumpe (erforderlich)
IDM_HOST=192.168.1.50
# Modbus-TCP-Verbindung
IDM_PORT=502
IDM_SLAVE_ID=1
IDM_TIMEOUT=10
IDM_MAX_RETRIES=3

# Modell: leer = automatische Erkennung (empfohlen). Alternativ alias setzen:
# navigator10 | navigator20 | navigatorpro | navigator17
# Bei manuellem Modell: Heizkreise (Standard "A"), Zonenmodule und Räume je Zone.
IDM_MODEL=
IDM_HEATING_CIRCUITS=
IDM_ZONE_MODULES=
IDM_ROOMS_PER_ZONE=6

# Schreibschutz: Schreiben erfordert ALLE folgenden Bedingungen.
# 1) IDM_ALLOW_WRITES=true
# 2) Write-Klasse des Registers in IDM_WRITE_CLASSES (volatile, cyclic, eeprom, write_only)
# 3) falls IDM_WRITABLE_KEYS gesetzt ist: Registernamen-Allowlist
# Zusätzlich validiert idm-heatpump-api min/max, Enums, Modellverfügbarkeit
# und drosselt wiederholte EEPROM-Schreibzugriffe.
IDM_ALLOW_WRITES=false
IDM_WRITE_CLASSES=
IDM_WRITABLE_KEYS=

# Sekunden, die ein read_all-Snapshot im Cache bleibt (0 = deaktiviert)
IDM_CACHE_TTL=5
