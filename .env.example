# IP-Adresse oder Hostname der Wärmepumpe (erforderlich)
IDM_HOST=192.168.1.50
# Modbus-TCP-Verbindung
IDM_PORT=502
IDM_SLAVE_ID=1
IDM_TIMEOUT=10
IDM_MAX_RETRIES=3

# Modell: leer = automatische Erkennung (empfohlen). Alternativ alias setzen:
# navigator10 | navigator20 | navigatorpro | navigator17
# Bei manuellem Modell: Heizkreise (Standard "A"), Zonenmodule und Räume je Zone.
IDM_MODEL=
IDM_HEATING_CIRCUITS=
IDM_ZONE_MODULES=
IDM_ROOMS_PER_ZONE=6

# Schreibschutz: Schreiben erfordert ALLE folgenden Bedingungen.
# 1) IDM_ALLOW_WRITES=true
# 2) Write-Klasse des Registers in IDM_WRITE_CLASSES (volatile, cyclic, eeprom, write_only)
# 3) falls IDM_WRITABLE_KEYS gesetzt ist: Registernamen-Allowlist
# Dies gilt genauso für Web-Schreibaktionen (über die äquivalente Write-Klasse).
IDM_ALLOW_WRITES=false
IDM_WRITE_CLASSES=
IDM_WRITABLE_KEYS=

# Sekunden, die ein read_all-Snapshot im Cache bleibt (0 = deaktiviert)
IDM_CACHE_TTL=5

# Hintergrund-Polling: Sekunden zwischen Snapshot-Aktualisierungen (0 = aus).
# Der Poller hält außerdem zyklische GLT-Anforderungen am Leben (cyclic writes).
IDM_POLL_INTERVAL=0

# Optionales Web-Supplement (Navigator 10 WebSocket / Navigator 2.0 HTTP).
# IDM_WEB_PIN = die im Controller gesetzte Web-PIN; leer = deaktiviert.
# IDM_WEB_VARIANT: leer/auto = aus dem erkannten Modell ableiten,
# nav10 | nav20 | off (explizit setzen oder abschalten).
IDM_WEB_PIN=
IDM_WEB_VARIANT=
IDM_WEB_PORT=61220

# MCP-Transport: stdio (Standard) oder http (Streamable-HTTP-Server).
# http bindet standardmäßig an 127.0.0.1 – Fernzugriff nur über
# Reverse-Proxy mit TLS/Auth absichern, niemals direkt exponieren.
IDM_TRANSPORT=stdio
IDM_HTTP_HOST=127.0.0.1
IDM_HTTP_PORT=8308
